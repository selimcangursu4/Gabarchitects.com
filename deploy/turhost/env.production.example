# Turhost production .env şablonu (TD-063). Sunucuda ~/gab/.env olarak kaydedilir — ASLA public_html içine konmaz.
# deploy/turhost/build.ps1 bu dosyadan dist/turhost/gab/.env üretir ve APP_KEY'i doldurur.
# <...> ile işaretli değerler cPanel'den alınır. Şifreler depoya yazılmaz.

APP_NAME="GAB Gayrimenkul Proje Geliştirme"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gabarchitects.com
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr

LOG_CHANNEL=daily
LOG_LEVEL=warning

# cPanel → MySQL Databases (cPanel kullanıcı adı ön eki dahil, ör. kullanici_gab)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=<cpanel_veritabani_adi>
DB_USERNAME=<cpanel_veritabani_kullanicisi>
DB_PASSWORD=<veritabani_sifresi>

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync

# cPanel → Email Accounts → info@gabarchitects.com → Connect Devices (SSL/TLS ayarları)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.gabarchitects.com
MAIL_PORT=465
MAIL_USERNAME=info@gabarchitects.com
MAIL_PASSWORD=<e-posta_sifresi>
MAIL_FROM_ADDRESS=info@gabarchitects.com
MAIL_FROM_NAME="${APP_NAME}"

# Yönetici hesabı: gab:sync-admin / ilk kurulum bu değerleri kullanır. İlk girişten sonra şifre panelden değiştirilebilir.
ADMIN_NAME="GAB Yönetici"
ADMIN_EMAIL=info@gabarchitects.com
ADMIN_PASSWORD=<yonetici_sifresi>

# Sunucunun GD kütüphanesi AVIF desteklemiyorsa false
MEDIA_AVIF=true

# Gerçek alan adı: arama motorlarına açık, www/http → https://gabarchitects.com (varsayılanlar production'da açık)
# SEO_INDEXABLE=
# CANONICAL_REDIRECT=
# TRUSTED_PROXIES tanımlanmaz (Turhost doğrudan Apache/LiteSpeed). Cloudflare kullanılırsa ayrıca değerlendirilir.
